<?xml version="1.0"?>
<sdf version="1.11">
  <model name="quadrotor">
    <!-- ENU yaw +90 deg makes body-forward point north, equivalent to NED yaw zero. -->
    <pose>0 0 2 0 0 1.57079632679</pose>
    <self_collide>false</self_collide>
    <link name="base_link">
      <inertial>
        <mass>1.46</mass>
        <inertia>
          <ixx>0.0288</ixx><iyy>0.0288</iyy><izz>0.0548</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.20 0.14 0.08</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.20 0.14 0.08</size></box></geometry>
        <material><ambient>0.03 0.18 0.45 1</ambient><diffuse>0.05 0.35 0.85 1</diffuse></material>
      </visual>
      <visual name="arm_one">
        <pose>0 0 0 0 0 0.785398</pose>
        <geometry><box><size>0.65 0.025 0.018</size></box></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="arm_two">
        <pose>0 0 0 0 0 -0.785398</pose>
        <geometry><box><size>0.65 0.025 0.018</size></box></geometry>
        <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <visual name="front_marker">
        <pose>0.13 0 0.045 0 0 0</pose>
        <geometry><sphere><radius>0.035</radius></sphere></geometry>
        <material><ambient>0.95 0.12 0.04 1</ambient><diffuse>0.95 0.12 0.04 1</diffuse></material>
      </visual>
      <sensor name="imu" type="imu">
        <always_on>true</always_on><update_rate>200</update_rate><topic>/quadrotor/imu</topic>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.001</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>0.01</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>

    <!-- Index order implied by the trained JAX allocation: FR, FL, RL, RR. -->
    <link name="rotor_0"><pose relative_to="base_link"> 0.1626 -0.1626 0.025 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz></inertia></inertial><visual name="v"><geometry><cylinder><radius>0.115</radius><length>0.008</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 0.45</ambient><diffuse>0.8 0.8 0.8 0.45</diffuse></material></visual></link>
    <link name="rotor_1"><pose relative_to="base_link"> 0.1626  0.1626 0.025 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz></inertia></inertial><visual name="v"><geometry><cylinder><radius>0.115</radius><length>0.008</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 0.45</ambient><diffuse>0.8 0.8 0.8 0.45</diffuse></material></visual></link>
    <link name="rotor_2"><pose relative_to="base_link">-0.1626  0.1626 0.025 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz></inertia></inertial><visual name="v"><geometry><cylinder><radius>0.115</radius><length>0.008</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 0.45</ambient><diffuse>0.8 0.8 0.8 0.45</diffuse></material></visual></link>
    <link name="rotor_3"><pose relative_to="base_link">-0.1626 -0.1626 0.025 0 0 0</pose><inertial><mass>0.01</mass><inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>2e-5</izz></inertia></inertial><visual name="v"><geometry><cylinder><radius>0.115</radius><length>0.008</length></cylinder></geometry><material><ambient>0.8 0.8 0.8 0.45</ambient><diffuse>0.8 0.8 0.8 0.45</diffuse></material></visual></link>

    <joint name="rotor_0_joint" type="revolute"><parent>base_link</parent><child>rotor_0</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="rotor_1_joint" type="revolute"><parent>base_link</parent><child>rotor_1</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="rotor_2_joint" type="revolute"><parent>base_link</parent><child>rotor_2</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>
    <joint name="rotor_3_joint" type="revolute"><parent>base_link</parent><child>rotor_3</child><axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis></joint>

    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame><robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/quadrotor/odometry</odom_topic><odom_publish_frequency>100</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>

    <!-- motorConstant * omega^2 = thrust; 9e-6 * 1000^2 = 9 N maximum. -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"><robotNamespace>quadrotor</robotNamespace><jointName>rotor_0_joint</jointName><linkName>rotor_0</linkName><turningDirection>ccw</turningDirection><timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>1000</maxRotVelocity><motorConstant>9e-6</motorConstant><momentConstant>0.018</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><actuator_number>0</actuator_number><rotorDragCoefficient>8.06428e-5</rotorDragCoefficient><rollingMomentCoefficient>1e-6</rollingMomentCoefficient><motorSpeedPubTopic>motor_speed/0</motorSpeedPubTopic><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType></plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"><robotNamespace>quadrotor</robotNamespace><jointName>rotor_1_joint</jointName><linkName>rotor_1</linkName><turningDirection>cw</turningDirection><timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>1000</maxRotVelocity><motorConstant>9e-6</motorConstant><momentConstant>0.018</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><actuator_number>1</actuator_number><rotorDragCoefficient>8.06428e-5</rotorDragCoefficient><rollingMomentCoefficient>1e-6</rollingMomentCoefficient><motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType></plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"><robotNamespace>quadrotor</robotNamespace><jointName>rotor_2_joint</jointName><linkName>rotor_2</linkName><turningDirection>ccw</turningDirection><timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>1000</maxRotVelocity><motorConstant>9e-6</motorConstant><momentConstant>0.018</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><actuator_number>2</actuator_number><rotorDragCoefficient>8.06428e-5</rotorDragCoefficient><rollingMomentCoefficient>1e-6</rollingMomentCoefficient><motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType></plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel"><robotNamespace>quadrotor</robotNamespace><jointName>rotor_3_joint</jointName><linkName>rotor_3</linkName><turningDirection>cw</turningDirection><timeConstantUp>0.0125</timeConstantUp><timeConstantDown>0.025</timeConstantDown><maxRotVelocity>1000</maxRotVelocity><motorConstant>9e-6</motorConstant><momentConstant>0.018</momentConstant><commandSubTopic>command/motor_speed</commandSubTopic><actuator_number>3</actuator_number><rotorDragCoefficient>8.06428e-5</rotorDragCoefficient><rollingMomentCoefficient>1e-6</rollingMomentCoefficient><motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType></plugin>
  </model>
</sdf>
